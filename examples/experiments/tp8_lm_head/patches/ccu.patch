+@pl.jit
+def l2_lm_head_ccu(
+    hidden_states: pl.Tensor[[T_DYN, D], pl.BF16],
+    lm_head_weight: pl.Tensor[[D, VOCAB_PER_TP], pl.BF16, pl.NZ],
+    logit_row_indices: pl.Tensor[[MAX_LOGIT_ROWS], pl.INT32],
+    logits: pl.Out[pl.Tensor[[MAX_LOGIT_ROWS, VOCAB], pl.FP32]],
+    sampled_ids: pl.Out[pl.Tensor[[MAX_LOGIT_ROWS, SAMPLED_IDS_PAD], pl.INT32]],
+    source: pl.InOut[pld.DistributedTensor[[1, MAX_LOGIT_ROWS * D], pl.BF16]],
+    hidden_window: pld.DistributedTensor[[GROUP_LOGIT_ROWS, D], pl.BF16],
+    target: pl.InOut[pld.DistributedTensor[[LM_HEAD_TP_SIZE, MAX_LOGIT_ROWS * D], pl.BF16]],
+    hidden_done: pld.DistributedTensor[[LM_HEAD_TP_SIZE, 1], pl.INT32],
+    logits_window: pld.DistributedTensor[[MAX_LOGIT_ROWS, VOCAB], pl.BF16],
+    logits_done: pld.DistributedTensor[[LM_HEAD_TP_SIZE, 1], pl.INT32],
+    group_base: pl.Scalar[pl.INT32],
+    tp_rank: pl.Scalar[pl.INT32],
+    done_epoch: pl.Scalar[pl.INT32],
+    completed_epochs: pl.Scalar[pl.INT32],
+):
+    """TP8/DP1 fixture. Publish selected BF16 rows in one contiguous source window."""
+    with pl.at(level=pl.Level.CORE_GROUP, name_hint="tp8_start_barrier", allow_early_resolve=False) as start_ready:
+        logits_done = pld.tensor.barrier(logits_done)
+    with pl.spmd(64, name_hint="lm_head_select_rows", deps=[start_ready]):
+        block = pl.tile.get_block_idx()
+        hidden_rows = pl.tensor.dim(hidden_states, 0)
+        for row in pl.range(block, MAX_LOGIT_ROWS, 64):
+            source_raw = pl.read(logit_row_indices, [row])
+            source_row = pl.cast(pl.max(pl.min(source_raw, hidden_rows - 1), 0), pl.INDEX)
+            selected = pl.full([1, D], dtype=pl.BF16, value=0.0)
+            if source_raw >= 0:
+                selected = hidden_states[source_row:source_row + 1, :]
+            source[0:1, row * D:(row + 1) * D] = selected
+    target = pld.tensor.allgather(source, target, hidden_done, engine="ccu")
+    logits_shards = pl.create_tensor([GROUP_LOGIT_ROWS, VOCAB_PER_TP], dtype=pl.BF16)
+    with pl.spmd(32, name_hint="lm_head_matmul") as projected:
+        _lm_head_projection(hidden_window, lm_head_weight, logits_shards, GROUP_LOGIT_ROWS, VOCAB_PER_TP, GROUP_M_TILE)
+    logits, completed = _lm_head_combine(
+        logits_shards, logits, hidden_done, logits_window, logits_done,
+        group_base, tp_rank, done_epoch, completed_epochs, 1, projected,
+    )
+    greedy_sample(logits, sampled_ids, completed)
+    return logits, sampled_ids
+
+
